{
  "name": "gblog",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
		"build:css": "sass assets/css/application.scss public/assets/css/application.css --load-path=node_modules --quiet-deps --silence-deprecation=import",
		"build:js": "esbuild assets/js/main.js --bundle --outdir=public/assets/js",
		"watch:js": "pnpm run build:js --watch=forever",
		"watch:css": "pnpm run build:css --watch",
		"build:assets": "pnpm run build:css && pnpm run build:js",
		"watch:assets": "pnpm run watch:css & pnpm run watch:js & wait"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
	"dependencies": {
		"@notion-render/client": "^0.0.2",
		"@notionhq/client": "^5.26.0",
		"bootstrap": "^5.3.8",
		"dotenv": "^17.4.2",
		"marked": "^18.0.11",
		"notion-to-md": "4.0.0-alpha.7",
		"prismjs": "^1.30.0",
		"pug": "^3.0.4",
		"slugify": "^1.6.9"
	},
  "devDependencies": {
		"@types/pug": "^2.0.10",
		"esbuild": "^0.28.2",
		"sass": "^1.103.1"
	}
}
